{
  "name": "ai-companion-phone",
  "private": true,
  "version": "0.5.0-alpha.5.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cleanup": "node scripts/cleanup-obsolete.mjs",
    "prebuild": "npm run cleanup",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "npm test && npm run build && npm run release:source-check",
    "release:source-check": "node scripts/release-safety.mjs source",
    "release:git-preflight": "node scripts/release-safety.mjs git-preflight",
    "release:git-working": "node scripts/release-safety.mjs git-working",
    "release:staged-check": "node scripts/release-safety.mjs staged"
  },
  "dependencies": {
    "@vite-pwa/assets-generator": "^1.0.0",
    "dexie": "^4.0.11",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  }
}
